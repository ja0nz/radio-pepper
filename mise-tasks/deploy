#!/usr/bin/env bash
#MISE description="Deploy to Hetzner Cloud"

# === Setup: Prepare SSH host keys in a temporary directory ===
temp_dir=$(mktemp -d)

# Ensure cleanup happens on script exit
cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

# --- 1. Create SSH directory structure in temp location ---
install -d -m755 "$temp_dir/persist/etc/ssh"

# Extract Private Key
sops -d --extract '["ssh_host_ed25519_key"]' "$MISE_PROJECT_ROOT/secrets/prod.enc.yaml" \
    > "$temp_dir/persist/etc/ssh/ssh_host_ed25519_key"
chmod 600 "$temp_dir/persist/etc/ssh/ssh_host_ed25519_key"

# Extract Public Key
sops -d --extract '["ssh_host_ed25519_key_pub"]' "$MISE_PROJECT_ROOT/secrets/prod.enc.yaml" \
    > "$temp_dir/persist/etc/ssh/ssh_host_ed25519_key.pub"
chmod 644 "$temp_dir/persist/etc/ssh/ssh_host_ed25519_key.pub"

# Extracting the remote SSH key with sops
KEY_PATH=$(mktemp)
trap 'rm -f "$KEY_PATH"' EXIT
chmod 600 "$KEY_PATH"
sops -d --extract '["id_ed25519"]' "$MISE_PROJECT_ROOT/secrets/prod.enc.yaml" \
    > "$KEY_PATH"

# === Detect server state: Custom NixOS vs Fresh Hetzner instance ===
export HCLOUD_TOKEN=$(sops -d --extract '["hetzner_api_token"]' "$MISE_PROJECT_ROOT/secrets/prod.enc.yaml")
REMOTE_IP4=$(hcloud server ip "$HETZNER_SERVER_NAME")
echo "🔍 Checking connectivity to $REMOTE_IP4..."

# Try connecting on custom SSH port to see if NixOS is already installed
if ssh -i "$KEY_PATH" \
       -p "$SSH_PORT" \
       -o ConnectTimeout=3 \
       -o BatchMode=yes \
       -o StrictHostKeyChecking=no \
       -o UserKnownHostsFile=/dev/null \
       "$USER@$REMOTE_IP4" true 2>/dev/null; then
    # NixOS is already installed with custom configuration
    deployment_port=$SSH_PORT
    deployment_user=$USER
    echo "✅ Custom NixOS environment detected (Port $deployment_port)"
else
    # Fresh Hetzner instance with default settings
    deployment_port=22
    deployment_user="root"
    echo "🐣 Fresh Hetzner instance detected (Falling back to Port 22/root)"
fi

# === Deploy: Run nixos-anywhere ===
echo "🚀 Deploying to $deployment_user@$REMOTE_IP4 on port $deployment_port..."

nix run github:nix-community/nixos-anywhere -- \
        --flake "$MISE_PROJECT_ROOT#prod-remote" \
        --extra-files "$temp_dir" \
        --target-host "$deployment_user@$REMOTE_IP4" \
        --ssh-port "$deployment_port" \
        -i "$KEY_PATH" \
        --build-on remote
